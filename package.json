{
  "name": "cashmine-preflight",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eas-cli": "^25.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
